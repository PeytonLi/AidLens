{
  "name": "aidlens",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "convex dev --start 'vite --open'",
    "predev": "convex init && node setup.mjs --once",
    "typecheck": "tsc -b",
    "build": "pnpm typecheck && vite build",
    "lint": "pnpm typecheck && eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:domain": "vitest run --project domain",
    "test:react": "vitest run --project react",
    "test:convex": "vitest run --project convex",
    "test:contract": "node -e \"console.log('test:contract skipped until Slice 4+')\"",
    "test:eval": "node -e \"console.log('test:eval skipped until Slice 5+')\"",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:sample": "playwright test e2e/public-sample.spec.ts",
    "smoke:convex": "playwright test --config playwright.convex.config.ts",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@convex-dev/auth": "^0.0.95",
    "convex": "^1.44.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@convex-dev/eslint-plugin": "^4.0.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "4.1.11",
    "convex-test": "0.0.56",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@tailwindcss/oxide"
    ]
  }
}
