# AidLens environment template
# Copy to `.env.local` for Vite. Put vendor secrets in the Convex dashboard,
# not in browser-visible VITE_* variables.

# Public Convex deployment URL (browser)
VITE_CONVEX_URL=
# Public HTTP-actions origin (for example https://your-deployment.convex.site)
VITE_CONVEX_SITE_URL=

# Convex local / deploy (generated by `npx convex` / `convex dev`)
# CONVEX_DEPLOYMENT=
# CONVEX_URL=

# Vendor keys — set in Convex environment only (never commit real values)
# FIREWORKS_API_KEY=
# FIREWORKS_MODEL=
# FIRECRAWL_API_KEY=
# FIRECRAWL_WEBHOOK_SECRET=
# AGENTMAIL_API_KEY=
# AGENTMAIL_WEBHOOK_SECRET=
# COLLEGE_SCORECARD_API_KEY=
# PUBLIC_SITE_URL=

# CI / deploy
# CONVEX_DEPLOY_KEY=

# Test flags
# E2E_TEST_MODE=1
# RUN_LIVE_SMOKE=1
